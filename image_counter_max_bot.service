[Unit]
Description=MAX-бот учёта фото (общая БД с Telegram-ботом)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/image_counter_bot
EnvironmentFile=-/root/image_counter_bot/.env
ExecStart=/root/image_counter_bot/venv/bin/python3 /root/image_counter_bot/src/max_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
